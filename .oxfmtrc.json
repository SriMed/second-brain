{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "package-lock.json",
    ".agents",
    "artifact-log.md",
    "cards.json",
    "vocab.json",
    "llm-knowledge-base.md",
    "product-and-research-notes.md",
    "artifacts"
  ]
}
